PORT=5000
JWT_SECRET=change-this-to-a-long-random-string

# FULL SONGS (any popular song, incl. Sinhala) - free key:
# Google Cloud Console -> create project -> enable "YouTube Data API v3" -> Credentials -> API key
YOUTUBE_API_KEY=

# Optional: free independent music, full length. https://devportal.jamendo.com
JAMENDO_CLIENT_ID=

# What the Home page shows (try: sinhala songs)
HOME_QUERY=top hits
